@using Microsoft.Extensions.Configuration;
@inject IConfiguration Configuration;
<!DOCTYPE HTML>
<html>
<head>
	<title>@Configuration.GetSection("Project")["Company"]</title>
	@await Html.PartialAsync("CssPartial")
	@await Html.PartialAsync("MetatagsPartial")
</head>
<body>
    <div id="page-wrapper">
        <!--Header-->
        @await Html.PartialAsync("HeaderPartial")
        <!--Main-->
        <div id="main">
            <div class="container">
                <div class="row main-row">
                    @* <div class="col-8 col-12-medium"> *@
                        @RenderBody()
                    @* </div> *@
                    <!--Sidebar-->
                    @await Html.PartialAsync("SidebarPartial")
                </div>
            </div>
        </div>  
        <!--Footer-->
        <div id="footer">
            @await Html.PartialAsync("FooterPartial")
        </div>
    </div>
    <!-- Scripts -->
    @await Html.PartialAsync("ScriptsPartial")
</body>
</html>