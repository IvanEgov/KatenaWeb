@using Katena.Domain
@inject DataManager datamanager;

@{ViewBag.picture += ".png";}
<div class ="test">
	<div class="question-text">
		<h1 class="question-symbol">"</h1>
		<h2>@ViewBag.question.Name</h2>
	</div>
	<div class="line-wrapper">
		<span class="line"></span>
	</div>
	<div class="question-image-actions">
		<div class="question-image">
			<img class="question-image-circle" src="~/images/@ViewBag.picture" alt="" data-position="center" />
			<h2 class="progerss-text">Ситуация @(ViewBag.index + 1)/@ViewBag.pack.QuestionsIds.Count</h2>
		</div>
		<div class="action">
			@foreach (Guid id in ViewBag.question.AnswerId)
			{
				AnswersBase answer = datamanager.Answers.GetAnswerById(id);
				ViewBag.reason = true;
				<form asp-controller="Tests" asp-action="NextQuestion">
					<input type="hidden" name="pack" value="@ViewBag.pack.Id">
					<input type="hidden" name="index" value="@ViewBag.index">
					<input type="hidden" name="answers" value="@answer.Id">
					<input type="hidden" name="reason" value="@Guid.Empty">
					<input type="hidden" name="gender" value="@ViewBag.gender">
					<input type="hidden" name="checkReason" value="True">
					<div class="button-question">
						<input type="submit" class="button-action" value="@answer.Action">
					</div>
				</form>
			}
		</div>
	</div>
</div>

