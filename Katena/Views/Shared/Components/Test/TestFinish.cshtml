 @using Katena.Domain
@inject DataManager datamanager;

<div class="result-wrapper">
	<div class="result-left">
		<div class="result-welcome">
			<div class="result-welcome-text">
				<h1 style="font-family:'Firenight-Regular';color:black;">Результат теста</h1>
				<h2 style="font-family:'Firenight-Regular';color:black;">Ваш тип</h2>
				<h2 style="font-family:'Firenight-Regular';color:black;">@ViewBag.calculateType @ViewBag.calculateStyle</h2>
			</div>
		</div>
		<div class="line-wrapper"
				<span class="result-line"></span>
			</div>
		<div class="result">
			@foreach (Guid id in ViewBag.pack.ResaultsId)
			{
				ResaultsBase result = datamanager.Resaults.GetResaultById(id);
				if (ViewBag.calculateType == result.Type && ViewBag.calculateStyle == result.Style && ViewBag.gender == result.Gender)
				{
					<h2 style="font-size:1.5em; font-family:'Firenight-Regular'; color:black;">@result.Resault</h2>
					ViewBag.trigerImage = result.TrigerImage + ".png";
				}
			}
		</div>
	</div>
		
	<div class="result-tables">
		<div class="distrib-table">
			<h1 style="color:black;">Производитель: @ViewBag.P%</h1>
			<h1 style="color:black;">Администратор: @ViewBag.A%</h1>
			<h1 style="color:black;">Производитель: @ViewBag.E%</h1>
			<h1 style="color:black;">Интегратор: @ViewBag.I%</h1>
			@if (ViewBag.gender == "man")
			{
				<h1 style="color:black;">Отеческий: @ViewBag.Parent%</h1>
				<h1 style="color:black;">Эгоцентричный: @ViewBag.Self%</h1>
				<h1 style="color:black;">Сыновий: @ViewBag.Children%</h1>
			}
			else if (ViewBag.gender == "woman")
			{
				<h1 style="color:black;">Материнский: @ViewBag.Parent%</h1>
				<h1 style="color:black;">Эгоцентричный: @ViewBag.Self%</h1>
				<h1 style="color:black;">Дочерний: @ViewBag.Children%</h1>
			}
			else
			{
				<h1 style="color:black;">error(File:TestFinish)</h1>
			}
		</div>
		<div class="triger-image">
			<img class="image" style="display:flex;" src="~/images/@ViewBag.TrigerImage" alt="" data-position="center" />
		</div>
	</div>
	<button class="button" id="homeButton"><a asp-area="" asp-controller="Home" asp-action="Index">Вернуться на главную</a></button>
</div>
