 @using Katena.Domain
@inject DataManager datamanager;

<div class="result-wrapper" style="text-align:center;">
	<div class="result-content">
		<div class="question">
			<p><h2>Прохождение теста завершено! Здесь вы можете увидеть результат!</h2></p>
		</div>
		<div class="result">
			@foreach (Guid id in ViewBag.pack.ResaultsId)
			{
				ResaultsBase result = datamanager.Resaults.GetResaultById(id);
				if (ViewBag.calculateType == result.Type && ViewBag.calculateStyle == result.Style && ViewBag.gender == result.Gender)
				{
					<p><h1>@result.Resault</h1></p>
				}
			}
		</div>
		<button class="button" onclick="showResults()" id="showButton">Показать все результаты</button>
		<button class="button" id="homeButton"><a asp-area="" asp-controller="Home" asp-action="Index">Вернуться на главную</a></button>
		<div id="results" hidden>
			@foreach (Guid id in ViewBag.pack.ResaultsId)
			{
				ResaultsBase result = datamanager.Resaults.GetResaultById(id);
				<div class="result">
					<p><h1>@result.Resault</h1></p>
				</div>
			}
		</div>
	</div>
</div>


<script>
	function showResults() {
		if (document.getElementById("results").hidden == false) {
			document.getElementById("results").hidden = true;
		}
		else {
			document.getElementById("results").hidden = false;
		}
	}
</script>