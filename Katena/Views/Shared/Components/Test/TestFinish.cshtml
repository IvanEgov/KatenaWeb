 @using Katena.Domain
@inject DataManager datamanager;

<div class="result-wrapper">
	<div class="result-left">
		<div class="result-welcome">
			<h2 style="color:white; font-weight:100; margin:0 0 0 0;">Результат теста</h2>
		</div>
		<div class="result-welcome-text">
			<h2 style="color:darkcyan;">Ваш тип</h2>
			<h2 style="color:darkcyan;">@ViewBag.calculateType @ViewBag.calculateStyle</h2>
		</div>
		<div class="line-wrapper">
				<span class="result-line"></span>
		</div>
		<div class="result">
			@foreach (Guid id in ViewBag.pack.ResaultsId)
			{
				ResaultsBase result = datamanager.Resaults.GetResaultById(id);
				if (ViewBag.calculateType == result.Type && ViewBag.calculateStyle == result.Style && ViewBag.gender == result.Gender)
				{
					<h2 style="font-size:1.5em; font-family:'Firenight-Regular'; color:black;">@result.Resault</h2>
					ViewBag.trigerImage = result.TrigerImage + ".png";
				}
			}
		</div>
	</div>
		
	<div class="result-tables">
		<div class="distrib-table">
			@* <h1 style="color:black;">Производитель: @ViewBag.P%</h1>
			<h1 style="color:black;">Администратор: @ViewBag.A%</h1>
			<h1 style="color:black;">Производитель: @ViewBag.E%</h1>
			<h1 style="color:black;">Интегратор: @ViewBag.I%</h1> *@
			@if (ViewBag.gender == "man")
			{
				<table class="table">
					<tr>
						<td colspan="4" style="color:black;border: 2px solid black;">Итог по гендернему дистрибутиву</td>
						<td colspan="2" style="color:black;border: 2px solid black;">Ваш психотип</td>
					</tr>
					<tr>
						<td style="color:black;border: 2px solid black;">Отеческий</td>
						<td colspan="2" style="color:black;border: 2px solid black;">Эгоцентричный</td>
						<td style="color:black;border: 2px solid black;">Сыновий</td>
						<td style="color:black;border: 2px solid black;">Стиль</td>
						<td style="color:black;border: 2px solid black;">Дистрибутив</td>
					</tr>
					<tr>
						<td id="maleParent" style="color:black;border: 2px solid black;">@ViewBag.Parent%</td>
						<td id="maleSelf" colspan="2" style="color:black;border: 2px solid black;">@ViewBag.Self%</td>
						<td id="maleChildren" style="color:black;border: 2px solid black;">@ViewBag.Children%</td>
						<td style="color:red;border: 2px solid black;">@ViewBag.calculateStyle</td>
						<td style="color:red;border: 2px solid black;">@ViewBag.calculateType</td>
					</tr>
					<tr>
						<td colspan="4" style="color:black;border: 2px solid black;">Итог по стилю управления процессами</td>
					</tr>
					<tr>
						<td style="color:black;border: 2px solid black;">Производитель</td>
						<td style="color:black;border: 2px solid black;">Администратор</td>
						<td style="color:black;border: 2px solid black;">Предпрениматель</td>
						<td style="color:black;border: 2px solid black;">Интегратор</td>
					</tr>
					<tr>
						<td id="maleP" style=" color:black;border: 2px solid black;">@ViewBag.P%</td>
						<td id="maleA" style=" color:black;border: 2px solid black;">@ViewBag.A%</td>
						<td id="maleE" style=" color:black;border: 2px solid black;">@ViewBag.E%</td>
						<td id="maleI" style=" color:black;border: 2px solid black;">@ViewBag.I%</td>
					</tr>
				</table>
				
			}
			else if (ViewBag.gender == "woman")
			{
				<div class="table-wrapper">
					<table style="border-collapse:collapse;">
						<tr>
							<td colspan="4" style="color:black; border: 2px solid black;">Итог по гендернему дистрибутиву</td>
							<td colspan="2" style="color:black;">Ваш психотип</td>
						</tr>
						<tr>
							<td style="color:black;border: 2px solid black;">Материнский</td>
							<td colspan="2" style="color:black;border: 2px solid black;">Эгоцентричный</td>
							<td style="color:black;border: 2px solid black;">Дочерний</td>
							<td style="color:black;border: 2px solid black;">Стиль</td>
							<td style="color:black;border: 2px solid black;">Дистрибутив</td>
						</tr>
						<tr>
							<td id="femaleParent" style="color:black;border: 2px solid black;">@ViewBag.Parent%</td>
							<td id="femaleSelf" colspan="2" style="color:black;border: 2px solid black;">@ViewBag.Self%</td>
							<td id="femaleChildren" style="color:black;border: 2px solid black;">@ViewBag.Children%</td>
							<td style="color:red;border: 2px solid black;">@ViewBag.calculateStyle</td>
							<td style="color:red;border: 2px solid black;">@ViewBag.calculateType</td>
						</tr>
						<tr>
							<td colspan="4" style="color:black;">Итог по стилю управления процессами</td>
						</tr>
						<tr>
							<td style="color:black;border: 2px solid black;">Производитель</td>
							<td style="color:black;border: 2px solid black;">Администратор</td>
							<td style="color:black;border: 2px solid black;">Предпрениматель</td>
							<td style="color:black;border: 2px solid black;">Интегратор</td>
						</tr>
						<tr>
							<td id="femaleP" style="color:black;border: 2px solid black;">@ViewBag.P%</td>
							<td id="femaleA" style="color:black;border: 2px solid black;">@ViewBag.A%</td>
							<td id="femaleE" style="color:black;border: 2px solid black;">@ViewBag.E%</td>
							<td id="femaleI" style="color:black;border: 2px solid black;">@ViewBag.I%</td>
						</tr>
					</table>
				</div>
				@* <h1 style="color:black;">Материнский: @ViewBag.Parent%</h1>
				<h1 style="color:black;">Эгоцентричный: @ViewBag.Self%</h1>
				<h1 style="color:black;">Дочерний: @ViewBag.Children%</h1> *@
			}
			else
			{
				<h1 style="color:black;">error(File:TestFinish)</h1>
			}
		</div>
		<div class="triger-image-wrapper">
			<img class="triger-image" src="~/images/@ViewBag.TrigerImage" alt="" data-position="center" />
		</div>
	</div>
	@* <button class="button" id="homeButton"><a asp-area="" asp-controller="Home" asp-action="Index">Вернуться на главную</a></button> *@
</div>