@using Katena.Domain
@inject DataManager datamanager;

@{ViewBag.picture += ".png";}
<div class="action-wrapper">
		<div class="question">
			<div class="question-text">
				<h1 style="float:left; padding-right:37.5px; font-family:'Firenight-Regular'; font-size:3.5em;">"</h1>
				<h2 style="font-family:'Firenight-Regular';">@ViewBag.question.Name</h2>
			</div>
			<div class="line-wrapper">
				<span class="line"></span>
			</div>
		</div>
		<div class="takeAction">
			<h3 style="float:left; margin-right:15px;">Вы выбрали действие: </h3>
			@* <div class="takenAction">@ViewBag.answer.Action</div> *@
			<div class="button-question-post">
				<input style="text-align:left; height:auto; line-height:50px;" type="submit" value="@ViewBag.answer.Action" disabled="1">
			</div>
			<h3>Каков ваш мотив?</h3>
		</div>
		<div class="question-image">
		<img class="image" style="width:400px;height:400px;" src="~/images/@ViewBag.picture" alt="" data-position="center" />
			<h2 style="font-family:'Firenight-Regular'">Ситуация @(ViewBag.index + 1)/@ViewBag.pack.QuestionsIds.Count</h2>
		</div>
		<div class="resons">
		@foreach (Guid id in ViewBag.answer.reasonsId)
		{
			ReasonBase reason = datamanager.Reasons.GetReasonById(id);
			<form style="display: inline-block;" asp-controller="Tests" asp-action="NextQuestion">
				<input type="hidden" name="pack" value="@ViewBag.pack.Id">
				<input type="hidden" name="index" value="@ViewBag.index">
				<input type="hidden" name="question" value="@ViewBag.question.Id">
				<input type="hidden" name="answer" value="@ViewBag.answer.Id">
				<input type="hidden" name="reason" value="@reason.Id">
				<input type="hidden" name="gender" value="@ViewBag.gender">
				<input type="hidden" name="checkReason" value="false">
				<div class="button-question">
					<input type="submit" style="text-align:left; height:auto; line-height:50px;" value="@reason.Reason">
				</div>
			</form>
		}
		</div>

	@* <div class="testProgressDots">
		@for (int i = 0; i < ViewBag.pack.QuestionsIds.Count; i++)
		{
			if (i < ViewBag.index)
			{
				<span class="previousDot">@(i + 1)</span>
				<span class="progressLine"></span>
			}
			else if (i == ViewBag.index)
			{
				<span class="nowDot">@(i + 1)</span>
				if (i < ViewBag.pack.QuestionsIds.Count - 1)
				{
					<span class="nextLine"></span>
				}
			}
			else
			{
				<span class="nextDot">@(i + 1)</span>
				if (i < ViewBag.pack.QuestionsIds.Count - 1)
				{
					<span class="nextLine"></span>
				}
			}
		}
	</div> *@
</div>
