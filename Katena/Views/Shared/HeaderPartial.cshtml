@using Microsoft.Extensions.Configuration;
@inject IConfiguration Configuration;
<div id="header-wrapper">
	<div class="container">
		<div class="row">
			<div class="col-12">
				<header id="header">
					<h1><a href="/" id="logo">@Configuration.GetSection("Project")["Company"]</a></h1>
                    <nav id="nav">
                        <a asp-area="" asp-controller="Home" asp-action="Index">Главная</a>
                        <a asp-area="" asp-controller="Tests" asp-action="Index" asp-route-id="">Тесты</a>
                        <a asp-area="" asp-controller="Abilities" asp-action="Index" asp-route-id="">Возможности</a>
                        <a asp-area="" asp-controller="Contacts" asp-action="Index" asp-route-id="">Контакты</a>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-area="" asp-controller="Cabinet" asp-action="Index" style="color: #f6781f; font-weight: bold;">Личный кабинет</a>
                            <a asp-area="" asp-controller="Account" asp-action="Logout">Выход</a>
                        }
                        else
                        {
                            <a asp-area="" asp-controller="Account" asp-action="Login">Вход</a>
                            <a asp-area="" asp-controller="Account" asp-action="Register">Регистрация</a>
                        }
                    </nav>
				</header>
			</div>
		</div>
	</div>
</div>