@model TextField
@{
	ViewBag.Title = Model.Title;
	ViewBag.Text = Model.Text;
	ViewBag.TitleImagePath = Model.TitleImagePath;
}
@using Katena.Domain
@inject DataManager datamanager;


<section id="sidebar">
	@await Html.PartialAsync("SidebarPartial")
</section>

<!-- Главная -->
<div id="wrapper">
	<section id="intro" class="wrapper style1 fullscreen fade-up">
		<div class="inner">
			<h1 style="font-family:'Firenight-Regular';">@Html.Raw(Model.Title)</h1>
			<p>
				<h3 style="font-family:'Firenight-Regular';">@Html.Raw(Model.Text)</h3>
			</p>
			<ul class="actions">
				<li><a asp-area="" asp-controller="FeedBack" asp-actio="Index" asp-route-id="" class="button scrolly">Связаться с нами</a></li>
				<li><a asp-area="" asp-controller="Tests" asp-action="Index" asp-route-id="" class="button scrolly">Пройти тест</a></li>
			</ul>
			@* <audio preload="auto" controls="controls">
				<source src="~/jazzMusic/3f4097ac04d1117.mp3" type="audio/mpeg">
				Тег audio не поддерживается вашим браузером.
			</audio> *@
		</div>
	</section>

	<!-- Тесты -->
	<section id="one" class="wrapper style2 spotlights">
		<section style="background-color:#1c918c">
			<a href="#" class="image"><img src="~/images/image1.jpg" alt="" data-position="center center" /></a>
			<div class="content">
				<div class="inner">
					<h2 style="font-family:'Firenight-Regular'">ОПИСАНИЕ ТЕСТА</h2>
					<p>Твоя роль в сценарии</p>
					<ul class="actions">
						<li><a asp-area="" asp-controller="Description" asp-action="Index" asp-route-id="" class="button scrolly" style="font-family:'Firenight-Regular'"><h2 style="line-height:2.5;">Learn more</h2></a></li>
					</ul>
				</div>
			</div>
		</section>
		<section style="background-color:#3395b0">
			<a href="#" class="image"><img src="~/images/image2.jpg" alt="" data-position="top center" /></a>
			<div class="content">
				<div class="inner">
					<h2 style="font-family:'Firenight-Regular'">ПРОЙТИ ТЕСТ</h2>
					<p>13 ситуаций, 52 варианта действий, 42 мотива</p>
					<ul class="actions">
						<li><a asp-area="" asp-controller="Tests" asp-action="Index" asp-route-id="" class="button" style="font-family:'Firenight-Regular'"><h2 style="line-height:2.5;">LEARN MORE</h2></a></li>
					</ul>
				</div>
			</div>
		</section>
	</section>
	<!--Все психотипы-->
	<section id="two" class="wrapper style2 spotlights">
		<section style="background-color:#1c918c">
			<a href="#" class="image"><img src="~/images/image1.jpg" alt="" data-position="center center" /></a>
			<div class="content">
				<div class="inner">
					<h2 style="font-family:'Firenight-Regular'">ЖЕНЩИНЫ</h2>
					<p>Описание всех женских психотипов</p>
					<ul class="actions">
						<li>
							<form asp-controller="ResultDescription" asp-action="Index">
								<input type="hidden" name="gender" value="female">
								<input type="submit" class="main-button" value="LEARN MORE">
							</form>
						</li>
						@* <li><a asp-area="" asp-controller="Description" asp-action="Index" asp-route-id="" class="button scrolly" style="font-family:'Firenight-Regular'"><h2 style="line-height:2.5;">Learn more</h2></a></li> *@
					</ul>
				</div>
			</div>
		</section>
		<section style="background-color:#3395b0">
			<a href="#" class="image"><img src="~/images/image2.jpg" alt="" data-position="top center" /></a>
			<div class="content">
				<div class="inner">
					<h2 style="font-family:'Firenight-Regular'">МУЖЧИНЫ</h2>
					<p>Описание всех мужских психотипов</p>
					<ul class="actions">
						<li>
							<form asp-controller="ResultDescription" asp-action="Index">
								<input type="hidden" name="gender" value="male">
								<input type="submit" class="main-button" value="LEARN MORE">
							</form>
						</li>
						@* <li><a asp-area="" asp-controller="Tests" asp-action="Index" asp-route-id="" class="button scrolly" style="font-family:'Firenight-Regular'"><h2 style="line-height:2.5;">LEARN MORE</h2></a></li> *@
					</ul>
				</div>
			</div>
		</section>
	</section>
	<div id="results" hidden>
		@foreach (ResaultsBase result in datamanager.Resaults.GetAllResaults())
		{
			<section id="two" class="wrapper style1 fullscreen fade-up">
				<div class="inner">
					@if (result.Gender == "man")
					{
						<h1>@result.Type @result.Style Мужчина</h1>
					}
					@if (result.Gender == "woman")
					{
						<h1>@result.Type @result.Style Женщина</h1>
					}
					<p>
						@Html.Raw(result.Resault)
					</p>
					<ul class="actions">
						<li><a href="#three" onclick="showResults()" class="button scrolly">Скрыть результаты</a></li>
					</ul>
				</div>
			</section>
		}
	</div>
	<!-- Возможности -->
