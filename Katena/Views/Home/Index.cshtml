	<section id="five" class="wrapper style1 fullscreen fade-up">
		<div class="inner">
			<h1 style="font-family:'Firenight-Regular'"></h1>
			<div id="picture" style="margin-left:650px;">
				<div>
					@* <img class="img-block" src="~/images/@ViewBag.TitleImagePath" /> *@
				</div>
			</div>
			<p>
				@* <h3 style="font-family:'Firenight-Regular'; font-size:large;">@Html.Raw(Model.Text)</h3> *@
			</p>
			<ul class="actions">@* 
