@{
    ViewData["Title"] = "Добавить сотрудника";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0 fs-5">➕ Добавление нового сотрудника</h4>
                </div>
                <div class="card-body">
                    @if (ViewBag.SuccessMessage != null)
                    {
                        <div class="alert alert-success">@Html.Raw(ViewBag.SuccessMessage)</div>
                    }

                    <form asp-action="AddEmployee" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Email сотрудника (будет логином)</label>
                            <input type="email" name="email" class="form-control" required placeholder="employee@company.com" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">ФИО сотрудника</label>
                            <input type="text" name="fullName" class="form-control" placeholder="Иванов Иван Иванович" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Создать и сгенерировать пароль</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>