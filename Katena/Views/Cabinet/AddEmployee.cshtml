@{
    ViewData["Title"] = "Добавить сотрудника";
}

<div class="container mt-5">
    <h2>Добавить нового сотрудника</h2>

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success" role="alert">
            @ViewBag.SuccessMessage
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <form asp-action="AddEmployee" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label for="email" class="form-label">Email сотрудника</label>
                    <input type="email" name="email" id="email" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label for="fullName" class="form-label">ФИО сотрудника</label>
                    <input type="text" name="fullName" id="fullName" class="form-control" />
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Добавить сотрудника</button>
                    <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
                </div>
            </form>
        </div>
    </div>
</div>