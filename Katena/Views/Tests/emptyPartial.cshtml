@model TextField
@{
	ViewBag.Title = Model.Title;
	ViewBag.Text = Model.Text;
	ViewBag.TitleImagePath = Model.TitleImagePath;
}
<div style="display:flex; justify-content:space-between; margin-left:100px;">
	<div style="display:inline-block; width:650px;">
		<h1 style="font-family:'Firenight-Regular'">@Html.Raw(Model.Text)</h1>
	</div>
	<div id="picture" style="display:inline-block; margin-left:60px;">
		<img class="img-block" src="~/images/@ViewBag.TitleImagePath" />
	</div>
</div>