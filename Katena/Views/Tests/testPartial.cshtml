@using Katena.Domain
@model QuestionPackBase
@{
	ViewBag.Title = Model.Name;
}
@inject DataManager datamanager;

<script>
	document.getElementById("startButton").addEventListener(
		"click",
		function () {
			document.getElementById("test").hidden = true;
			document.getElementById("start").hidden = false;
		},
		false,
	);
</script>

<div id="sidebar">
	<div id="test">
		<h4>@Model.Name</h4>
		<div class="picture">
			<!--Картинка теста-->
		</div>
		<button class="botton" id="startBotton">Начать тест</button>
		@* <form asp-controller="Test" asp-action="Index" method="post">
			<input type="hidden" name ="test" value="Model">
			<button><a href="#" onclick="document.getElementById('form-@Model.Id').submit();">Начать тест</a></button>
			<bottom><a asp-controller="" asp-action="" method="post">Начать тест</a></bottom>
		</form> *@
	</div>

	<div id="start" hidden>
		@foreach (Guid questId in Model.QuestionsIds)
		{
			QuestionBase question = datamanager.QuestionBase.GetQuestionById(questId);
			@await Html.PartialAsync("questionPartial", question)
		}
	</div>
</div>