@using Katena.Domain
@model QuestionPackBase
@{
	ViewBag.Title = Model.Name;
}
@inject DataManager datamanager;

<div id="sidebar">
	<div id="test">
		<h2>@Model.Name</h2>
		<div class="picture">
			<!--Картинка теста-->
		</div>
	</div>
	@{List<Guid> guidQuest = Model.QuestionsIds.ToList();}

	@foreach (Guid questId in guidQuest)
	{
		QuestionBase question = datamanager.QuestionBase.GetQuestionById(questId);
		<br>
		<h1>@question.Name</h1>
		<br>
		<form>	
			@{List<Guid> guidAns = question.AnswerId.ToList();}
			@if(guidAns.Count != null)
			{
				@foreach (Guid answerId in guidAns)
				{
					AnswersBase answer = datamanager.Answers.GetAnswerById(answerId);
					<div class="form-check">
						<input class="form-check-input" type="radio" name="flexRadioDefault" id="flexRadioDefault1">
						<label class="form-check-label" for="flexRadioDefault1">
							@answer.Action.  @answer.Reason
						</label>
					</div>
				}
			}
		</form>
	}
	<button class="botton" id="startBotton">Закончить тест</button>
</div>