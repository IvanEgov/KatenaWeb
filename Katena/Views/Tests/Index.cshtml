@using Katena.Domain
@{
	ViewBag.Title = Model.Title;
	ViewBag.Text = Model.Text;
}

<script>
    event.target.addEventListener(
        "click",
        function () {
            document.getElementById("welcome").hidden = true;
            document.getElementById("test").hidden = false;
        },
        false,
    );
</script>

@inject DataManager datamanager;

<div>
	@Html.Raw(Model.Text)
    <div>
        @{
            List<QuestionPackBase> packs = datamanager.Packs.GetAllPacks().ToList();
        }
        @if (ViewBag.pack == null)
        {
            @foreach (QuestionPackBase entity in packs)
            {
                <!--TODO: Разобраться со скриптом(кнопками)-->
                <div class="container">
                    <div class="col-12-medium">
                        <botton class="button" id="startButton-@entity.Id"><h3>@entity.Name</h3></botton>
                    </div>
                    <div class="container">
                        <div class="col-8">
                            <div id="test-@entity.Id">
                                @await Component.InvokeAsync("Test", new { pack = entity, index = -1 });<!--Check this for finish:https://learn.microsoft.com/ru-ru/aspnet/core/mvc/views/view-components?view=aspnetcore-8.0 teg for find("Вызов компонента представления")-->
                            </div>
                            <div id="welcome-@entity.Id">
                                @await Html.PartialAsync("emptyPartial")
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div id="test">
                @await Component.InvokeAsync("Test", new { pack = ViewBag.pack, index = ViewBag.index })
            </div>
        }
        
    </div>
</div>