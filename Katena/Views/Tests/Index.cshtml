@using Katena.Domain
@{
	ViewBag.Title = Model.Title;
	ViewBag.Text = Model.Text;
}

@inject DataManager datamanager;

<div>
    <div style="display:flex; justify-content:space-between;">
        @{
            List<QuestionPackBase> packs = datamanager.Packs.GetAllPacks().ToList();
        }
        @if (ViewBag.pack == null)
        {
            @foreach (QuestionPackBase entity in packs)
            {
                <!--TODO: Разобраться со скриптом(кнопками)-->
                <div class="container">
                    <div style="display:flex; left:15%" class="container">
                        <div class="col-8">
                            <div id="test" hidden>
                                @await Component.InvokeAsync("Test", new { pack = entity, index = -1 })
                            </div>
                            <div id="welcome">
                                @await Html.PartialAsync("emptyPartial")
                                <div style="display:flex; left:15%;">
                                    <button class="button" id="startButton">@entity.Name</button>
                                </div>
                                
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            @foreach(QuestionPackBase entity in packs)
            {
                <form style="display: inline-block;" asp-controller="Tests" asp-action="NextQuestion">
                    <input type="hidden" name="pack" value="@entity">
                    <input type="hidden" name="index" value="-1">
                    <div class="button" style="margin-bottom: 40px; display:inline-block;">
                        <input type="submit" value="@entity.Name">
                    </div>
                </form>
            }
            <div id="test" style="display:inline-block; left:15%;" class="container">
                @await Component.InvokeAsync("Test", new
                    {
                        pack = ViewBag.pack,
                        index = ViewBag.index,
                        reason = ViewBag.reason,
                        answer = ViewBag.answer,
                        distr_mentorP = ViewBag.distr_mentorP,
                        distr_lookingP = ViewBag.distr_lookingP,
                        distr_hunterP = ViewBag.distr_hunterP,
                        distr_mentor = ViewBag.distr_mentor,
                        distr_looking = ViewBag.distr_looking,
                        distr_hunter = ViewBag.distr_hunter,
                        style_PP = ViewBag.style_PP,
                        style_AA = ViewBag.style_AA,
                        style_EE = ViewBag.style_EE,
                        style_II = ViewBag.style_II,
                        style_P = ViewBag.style_P,
                        style_A = ViewBag.style_A,
                        style_E = ViewBag.style_E,
                        style_I = ViewBag.style_I
                    })
            </div>
        }
        
    </div>
</div>

<script>
    document.getElementById("startButton").addEventListener(
        "click",
        function () {
            document.getElementById("welcome").hidden = true;
            document.getElementById("test").hidden = false;
        },
    );
</script>