@using Katena.Domain
@model TextField
@{
	ViewBag.Title = Model.Title;
	ViewBag.Text = Model.Text;
}
@inject DataManager datamanager;

<script>
    document.getElementById("startButton").addEventListener(
        "click",
        function () {
            document.getElementById("welcome").hidden = true;
            document.getElementById("test").hidden = false;
        },
        false,
    );
</script>

<div>
	@Html.Raw(Model.Text)
    <div>
        @{
            List<QuestionPackBase> packs = datamanager.Packs.GetAllPacks().ToList();
        }
        @foreach (QuestionPackBase entity in packs)
        {
            <!--TODO: redo on use of TestViewComponent and new model {pack+index} if carrying test, or {empty} if first appear-->
            <div class="container">
                <div class="col-12-medium">
                    <botton class="button" id="startButton"><h3>@entity.Name</h3></botton>
                </div>
                <div class="container">
                    <div class="col-8">
                        <div id="test">
                            <div id="testPartial">
                                @await Html.PartialAsync("testPartial", entity)
                            </div>
                        </div>
                        <div id="welcome">
                            <h1>standart page</h1>
                        </div>
                    </div>
                </div>
                <div id="test">
                    <div id="testPartial">
                        @await Html.PartialAsync("testPartial", entity)
                    </div>
                </div>
                <div id="welcome">
                    <h1></h1>
                </div>
            </div>
        }
    </div>
</div>