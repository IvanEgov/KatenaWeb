@using Katena.Domain
@model QuestionPackBase
@inject TextField textField;
@{
    ViewBag.Title = textField.Title;
    ViewBag.Text = textField.Text;
}
@inject DataManager datamanager;

<div>
    @Html.Raw(textField.Text)
    <div>
        @foreach (QuestionPackBase entity in datamanager.Packs.GetAllPacks())
        {
            <div class="container">
                <div class="col-12">
                    <form style="display: inline-block;" id="form-@entity.Id" asp-controller="Tests" asp-action="ShowTest" method="post">
                        <input type="hidden" name="id" value="@entity.Id"></input>
                        <button><a href="#" onclick="document.getElementById('form-@entity.Id').submit();">Тест</a></button>
                    </form>
                </div>
            </div>
        }
    </div>
    <div class="container">
        @Model.Name
        @Model.Description
        @Model.Instructions
    </div>
</div>