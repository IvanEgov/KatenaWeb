@model DataManager
@{
    string strTitle = "Панель администратора";
    ViewBag.Title = strTitle;
}

<div>
    <h2>@strTitle</h2>
    <div>
        <h3>Наши тесты</h3>
        <div class="div-box">
            <a asp-area="Admin" asp-controller="TestItems" asp-action="Edit" asp-route-id="">Добавить тест</a>
        </div>
        <div>
            @foreach (QuestionPackBase entity in Model.Packs.GetAllPacks())
            {
                <div>
                    @entity.Name
                    |
                    <button><a asp-area="Admin" asp-controller="TestItems" asp-action="Edit" asp-route-id="@entity.Id">редактировать</a></button>
                    |
                    <form style="display: inline-block;" id="form-@entity.Id" asp-area="Admin" asp-controller="TestItems" asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@entity.Id">
                        <button><a href="#" onclick="document.getElementById('form-@entity.Id').submit();">удалить</a></button>
                    </form>
                </div>
            }
        </div>
        
    </div>

    <div>
        <h3>Редактировать новостную ленту</h3>
        <div class="div-box">
            <a asp-area="Admin" asp-controller="News" asp-action="Edit" asp-route-id="">Добавить новость</a>
        </div>
        @foreach (NewsBase entity in Model.News.GetNews())
        {
            <div>
                @entity.Title
                |
                <button><a asp-area="Admin" asp-controller="News" asp-action="Edit" asp-route-id="@entity.Id">редактировать</a></button>
                |
                <form style="display: inline-block;" id="form-@entity.Id" asp-area="Admin" asp-controller="News" asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@entity.Id">
                    <button><a href="#" onclick="document.getElementById('form-@entity.Id').submit();">удалить</a></button>
                </form>
            </div>
        }
    </div>
    <div class="div-box">
        <h3>Редактировать страницы сайта</h3>
        <a asp-area="Admin" asp-controller="TextField" asp-action="Edit" asp-route-codeWord="PageIndex">Главная</a>
        <a asp-area="Admin" asp-controller="TextField" asp-action="Edit" asp-route-codeWord="PageTests">Тесты</a>
        <a asp-area="Admin" asp-controller="TextField" asp-action="Edit" asp-route-codeWord="PageAbilities">Возможности</a>
        <a asp-area="Admin" asp-controller="TextField" asp-action="Edit" asp-route-codeWord="PageContacts">Контакты</a>
    </div>
    <div class="div-box">
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
            <input type="submit" value="Выйти" />
        </form>
    </div>
</div>