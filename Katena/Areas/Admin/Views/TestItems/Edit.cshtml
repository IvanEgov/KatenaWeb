@model QuestionPackBase
@{
    string strTitle = "Редактировать запись";
    ViewBag.Title = strTitle;
    ViewBag.Test = Model;
}
@inject DataManager datamanager;
<script src="~/js/ckeditor/ckeditor.js"></script>



<div>
    <h2>@strTitle</h2>
    <div>
        <form asp-area="Admin" asp-controller="TestItems" asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="QuestionsIds" />
            <input type="hidden" asp-for="ResaultsId" />

            <div asp-validation-summary="All"></div>
            <div class="div-box">
                <label asp-for="Name"></label>
                <input asp-for="Name">
                <span asp-validation-for="Name"></span>
            </div>
            <div class="div-box">
                <label asp-for="Description"></label>
                <textarea asp-for="Description"></textarea>
                <span asp-validation-for="Description"></span>
            </div>
            <div class="div-box">
                <label asp-for="Instructions"></label>
                <textarea asp-for="Instructions"></textarea>
                <span asp-validation-for="Instructions"></span>
            </div>
            <div class="div-box">
                <label asp-for="TitleImagePath"></label>
                <input type="file" name="titleImageFile" id="titleImageFile" />
                <div>
                    <img class="img-block" src="~/images/@Model.TitleImagePath" />
                </div>
            </div>
            <div class="div-box">
                <label asp-for="Background"></label>
                <textarea asp-for="Background"></textarea>
                <span asp-validation-for="Background"></span>
            </div>
            <div class="div-box">
                <label asp-for="Pictures"></label>
                <textarea asp-for="Pictures"></textarea>
                <span asp-validation-for="Pictures"></span>
            </div>
            <input type="submit" value="Сохранить">
        </form>

        <button><a asp-area="Admin" asp-controller="Question" asp-action="Edit" >Добавить вопрос</a></button>
        <div id="Questions">
            @foreach (QuestionBase entity in datamanager.QuestionBase.GetAllQuestions())
            {
                @* @if(Model.QuestionsIds.Contains(entity.Id))
                { *@
                    <div>
                        @entity.Name
                        |
                        <button><a asp-area="Admin" asp-controller="Question" asp-action="Edit" asp-route-id="@entity.Id">Редактировать</a></button>
                        |
                        <form style="display: inline-block;" id="form-@entity.Id" asp-area="Admin" asp-controller="TestItems" asp-action="DeleteQuestion" method="post">
                            <input type="hidden" name="id" value="@entity.Id">
                            <input type="hidden" name="testId" value="@Model.Id">
                            <input type="submit" value="Удалить">
                        </form>
                        |
                        @if (Model.QuestionsIds.FirstOrDefault<Guid>(x => x == entity.Id, Guid.Empty) == Guid.Empty)
                        {
                            <form style="display: inline-block;" id="form-@Model.Id" asp-area="Admin" asp-controller="TestItems" asp-action="AddQuestion" method="post">
                                <input type="hidden" name="questionId" value="@entity.Id">
                                <input type="hidden" name="testId" value="@Model.Id">
                                <input type="submit" value="Сохранить в тест">
                            </form>
                        }
                    </div>
                @* } *@
            }
        </div>
        <div class="div-box">
            <button><a asp-area="Admin" asp-controller="Resault" asp-action="Edit" asp-route-id="">Добавить Результат</a></button>
        </div>
        <div id="Results">
            @foreach (ResaultsBase entity in datamanager.Resaults.GetAllResaults())
            {
                <div>
                    @entity.Type
                    |
                    <button><a asp-area="Admin" asp-controller="Resault" asp-action="Edit" asp-route-id="@entity.Id">Редактировать</a></button>
                    |
                    <form style="display: inline-block;" id="form-@entity.Id" asp-area="Admin" asp-controller="TestItems" asp-action="DeleteResult" method="post">
                        <input type="hidden" name="id" value="@entity.Id">
                        <input type="hidden" name="testId" value="@Model.Id">
                        <input type="submit" value="Удалить">
                    </form>
                    |
                    @if (Model.ResaultsId.FirstOrDefault<Guid>(x => x == entity.Id, Guid.Empty) == Guid.Empty)
                    {
                        <form style="display: inline-block;" id="form-@Model.Id" asp-area="Admin" asp-controller="TestItems" asp-action="AddResault" method="post">
                            <input type="hidden" name="testId" value="@Model.Id">
                            <input type="hidden" name="resaultId" value="@entity.Id">
                            <input type="submit" value="Сохранить в тест">
                        </form>
                    }
                </div>
            }
        </div>
        <form style="display: inline-block;" id="form-@Model.Id" asp-area="Admin" asp-controller="TestItems" asp-action="ReturnHome" method="post">
            <input type="submit" value="Вернуться на главную страницу">
        </form>
    </div>
</div>



<script>
    window.onload = function () {
        var newCKEdit = CKEDITOR.replace('@Html.IdFor(x => x.Id)');
        newCKEdit.updateElement();
    }
</script>