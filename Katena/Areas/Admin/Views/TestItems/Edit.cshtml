@model QuestionPackBase
@{
    string strTitle = "Редактировать запись";
    ViewBag.Title = strTitle;
}

<script src="~/js/ckeditor/ckeditor.js"></script>

<div>
    <h2>@strTitle</h2>
    <div>
        <form asp-area="Admin" asp-controller="TestItems" asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All"></div>
            <div class="div-box">
                <label asp-for="Name"></label>
                <input asp-for="Name">
                <span asp-validation-for="Name"></span>
            </div>
            <div class="div-box">
                <label asp-for="Description"></label>
                <input asp-for="Description">
                <span asp-validation-for="Description"></span>
            </div>
            <div class="div-box">
                <label asp-for="Instructions"></label>
                <input asp-for="Instructions">
                <span asp-validation-for="Instructions"></span>
            </div>
            <input type="submit" value="Сохранить" />
        </form>
    </div>
</div>



<script>
    window.onload = function () {
        var newCKEdit = CKEDITOR.replace('@Html.IdFor(x => x.Id)');
        newCKEdit.updateElement();
    }
</script>