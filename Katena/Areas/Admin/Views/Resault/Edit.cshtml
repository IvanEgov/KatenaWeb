@model ResaultsBase
@{
    string strTitle = "Редактировать запись";
    ViewBag.Title = strTitle;
}

<script src="~/js/ckeditor/ckeditor.js"></script>

<div>
    <h2>@strTitle</h2>
    <div>
        <form asp-area="Admin" asp-controller="Resault" asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All"></div>
            <div class="div-box">
                <label asp-for="Gender"></label>
                <input asp-for="Gender" />
                <span asp-validation-for="Gender"></span>
            </div>
            <div class="div-box">
                <label asp-for="Style"></label>
                <input asp-for="Style">
                <span asp-validation-for="Style"></span>
            </div>
            <div class="div-box">
                <label asp-for="Type"></label>
                <input asp-for="Type">
                <span asp-validation-for="Type"></span>
            </div>
            <div class="div-box">
                <label asp-for="Resault"></label>
                <input asp-for="Resault">
                <span asp-validation-for="Resault"></span>
            </div>
            <input type="submit" value="Сохранить" />
        </form>
        <form style="display: inline-block;" id="form-@Model.Id" asp-area="Admin" asp-controller="Answer" asp-action="ReturnHome" method="post">
            <input type="submit" value="Вернуться на главную страницу">
        </form>
    </div>
</div>



<script>
    window.onload = function () {
        var newCKEdit = CKEDITOR.replace('@Html.IdFor(x => x.Id)');
        newCKEdit.updateElement();
    }
</script>