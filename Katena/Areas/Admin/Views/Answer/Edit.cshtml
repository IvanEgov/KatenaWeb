@model AnswersBase
@{
    string strTitle = "Редактировать запись";
    ViewBag.Title = strTitle;
}

<script src="~/js/ckeditor/ckeditor.js"></script>

<div>
    <h2>@strTitle</h2>
    <div>
        <form asp-area="Admin" asp-controller="Answer" asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All"></div>
            <div class="div-box">
                <label asp-for="Action"></label>
                <input asp-for="Action"/>
                <span asp-validation-for="Action"></span>
            </div>
            <div class="div-box">
                <label asp-for="Reason"></label>
                <input asp-for="Reason">
                <span asp-validation-for="Reason"></span>
            </div>
            <div class="div-box">
                <label asp-for="Type"></label>
                <input asp-for="Type">
                <span asp-validation-for="Type"></span>
            </div>
            <div class="div-box">
                <label asp-for="Weight"></label>
                <input asp-for="Weight">
                <span asp-validation-for="Weight"></span>
            </div>
            <input type="submit" value="Сохранить" />
        </form>
        <form style="display: inline-block;" id="form-@Model.Id" asp-area="Admin" asp-controller="Answer" asp-action="ReturnHome" method="post">
            <input type="submit" value="Вернуться на главную страницу">
        </form>
    </div>
</div>



<script>
    window.onload = function () {
        var newCKEdit = CKEDITOR.replace('@Html.IdFor(x => x.Id)');
        newCKEdit.updateElement();
    }
</script>