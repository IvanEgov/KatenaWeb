@model QuestionBase
@{
    string strTitle = "Редактировать запись";
    ViewBag.Title = strTitle;
}
@inject DataManager model;
<script src="~/js/ckeditor/ckeditor.js"></script>

<div>
    <h2>@strTitle</h2>
    <div>
        <form asp-area="Admin" asp-controller="Question" asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All"></div>
            <div class="div-box">
                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="div-box">
                <a asp-area="Admin" asp-controller="Answer" asp-action="Edit" asp-route-id="">Добавить Ответ</a>
            </div>
            <div>
                @foreach (AnswersBase entity in model.Answers.GetAllAnswers())
                {
                    <div>
                        <a asp-area="Admin" asp-controller="Answer" asp-action="Edit" asp-route-id="@entity.Id">редактировать</a>
                        |
                        <form style="display: inline-block;" id="form-@entity.Id" asp-area="Admin" asp-controller="Answer" asp-action="Delete" method="post">
                            <input type="hidden" name="id" value="@entity.Id">
                            <a href="#" onclick="document.getElementById('form-@entity.Id').submit();">удалить</a>
                        </form>
                        |
                        <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-id="@entity.Id">
                            @($"{entity.Action}")
                        </a>
                    </div>
                }
            </div>
            <div class="div-box">
                <label asp-for="AnswerId"></label>
                <input type="hidden" asp-for="AnswerId">
                <span asp-validation-for="AnswerId"></span>
            </div>
            <input type="submit" value="Сохранить" />
        </form>
    </div>
</div>



<script>
    window.onload = function () {
        var newCKEdit = CKEDITOR.replace('@Html.IdFor(x => x.Id)');
        newCKEdit.updateElement();
    }
</script>