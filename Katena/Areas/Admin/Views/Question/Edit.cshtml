@model QuestionBase
@{
    string strTitle = "Редактировать запись";
    ViewBag.Title = strTitle;
}
@inject DataManager model;
<script src="~/js/ckeditor/ckeditor.js"></script>

<div>
    <h2>@strTitle</h2>
    <div>
        <form asp-area="Admin" asp-controller="Question" asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="AnswerId" />

            <div asp-validation-summary="All"></div>
            <div class="div-box">
                <label asp-for="Name"></label>
                <input asp-for="Name" />
                <span asp-validation-for="Name"></span>
            </div>
            <input type="submit" value="Сохранить" />
        </form>
        
        <button><a asp-area="Admin" asp-controller="Answer" asp-action="Edit" asp-rout-id="">Добавить ответ</a></button>
        <div>
            @foreach (AnswersBase entity in model.Answers.GetAllAnswers())
            {
                <div>
                    <button><a asp-area="Admin" asp-controller="Answer" asp-action="Edit" asp-route-id="@entity.Id">Редактировать</a></button>
                    |
                    <form style="display: inline-block;" id="form-@entity.Id" asp-area="Admin" asp-controller="Question" asp-action="DeleteAnswer" method="post">
                        <input type="hidden" name="id" value="@entity.Id">
                        <input type="hidden" name="questionId" value="@Model.Id">
                        <button><a href="#" onclick="document.getElementById('form-@entity.Id').submit();">Удалить</a></button>
                    </form>
                    |
                    @if (Model.AnswerId.FirstOrDefault<Guid>(x => x == entity.Id, Guid.Empty) == Guid.Empty)
                    {
                        <form style="display: inline-block;" id="form-@Model.Id" asp-area="Admin" asp-controller="Question" asp-action="AddAnswer" method="post">
                            <input type="hidden" name="questionId" value="@Model.Id">
                            <input type="hidden" name="answerId" value="@entity.Id">
                            <button><a href="#" onclick="document.getElementById('form-@Model.Id').submit();">Сохранить в вопрос</a></button>
                        </form>
                    }
                </div>
            }
        </div>
        <form style="display: inline-block;" id="form-@Model.Id" asp-area="Admin" asp-controller="TestItems" asp-action="ReturnHome" method="post">
            <input type="submit" value="Вернуться на главную страницу">
        </form>
    </div>
</div>



<script>
    window.onload = function () {
        var newCKEdit = CKEDITOR.replace('@Html.IdFor(x => x.Id)');
        newCKEdit.updateElement();
    }
</script>